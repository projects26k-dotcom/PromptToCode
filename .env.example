# Backend Server Configuration
PORT=5000

# Clerk Authentication Keys (Stored on Backend)
# Get yours from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Clerk Webhook Secret (for production Svix signature verification)
# Get this when creating a webhook endpoint in Clerk Dashboard -> Webhooks -> Add Endpoint (/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# MongoDB Database Connection String
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prompttocode?retryWrites=true&w=majority
# Example Local MongoDB: mongodb://localhost:27017/prompttocode
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prompttocode?retryWrites=true&w=majority
